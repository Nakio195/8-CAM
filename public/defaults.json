    "overlap": 0.15,
    "direction": "climb",
    "combinePasses": true,
    "extraOffset": 0
  },
  "drilling": {
    "$comment": "cycle: simple or peck; peckDepth: mm per peck; dwell: s at the bottom of each hole",
